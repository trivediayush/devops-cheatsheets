{
  "name": "devops-cheatsheet",
  "version": "1.0.0",
  "description": "Open-source DevOps, SRE and platform engineering cheatsheets.",
  "scripts": {
    "dev": "vitepress dev --host 0.0.0.0 --port 3000",
    "build": "vitepress build",
    "preview": "vitepress preview --host 0.0.0.0 --port 3000",
    "check:links": "node scripts/check-links.mjs",
    "check": "npm run check:links && npm run build",
    "test": "npm run check:links"
  },
  "keywords": [
    "devops",
    "sre",
    "platform-engineering",
    "kubernetes",
    "docker",
    "terraform",
    "ci-cd",
    "cloud",
    "linux",
    "devsecops",
    "cheatsheets"
  ],
  "author": "Ayush Trivedi",
  "license": "MIT",
  "type": "commonjs",
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  }
}
